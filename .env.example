# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# E-mail notifications (New lead inquiries delivery)
NOTIFICATION_EMAIL="info@admatsu.com"

# OPTION 1: SMTP Server (e.g. for info@admatsu.com from your domain email host)
SMTP_HOST="smtp.admatsu.com"
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER="info@admatsu.com"
SMTP_PASS="your_email_password"
SMTP_FROM="ADMATSU Poptávky <info@admatsu.com>"

# OPTION 2: Resend API alternative
# RESEND_API_KEY="re_your_api_key_here"
